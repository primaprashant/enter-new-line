{
  "name": "enter-new-line",
  "version": "2.0.0",
  "description": "Stop accidentally sending half-finished prompts. Enter inserts a new line, Cmd+Enter sends. Browser extension that works on ChatGPT, Claude, Gemini & more.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Prashant Anand",
  "homepage": "https://github.com/primaprashant/enter-new-line",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primaprashant/enter-new-line.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:chrome": "cross-env TARGET=chrome vite build",
    "build:firefox": "cross-env TARGET=firefox vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "icons:render": "node scripts/render-icons.mjs",
    "package:chrome": "npm run build:chrome && node scripts/package.mjs chrome",
    "package:firefox": "npm run build:firefox && node scripts/package.mjs firefox",
    "package": "npm run package:chrome && npm run package:firefox"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@types/webextension-polyfill": "^0.12.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
